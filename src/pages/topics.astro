---
import "../styles.css";
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import SeoFaq from "../components/SeoFaq.astro";
import { pillars } from "../lib/pillars";
import { buildGenericFaqs, getKeywordTargetByUrl } from "../lib/seo";
const seo = getKeywordTargetByUrl("/topics/")!;
const benefit = "Explore finance pillars covering money, banking, investing, markets, accounting, tax, planning and professional exam preparation.";
const faqs = buildGenericFaqs(seo.primaryKeyword, benefit);
const pageH1 = seo.primaryKeyword.charAt(0).toUpperCase() + seo.primaryKeyword.slice(1);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead target={seo} benefit={benefit} faqs={faqs} />
    <SiteFonts />
  </head>
  <body class="bg-surface">
    <SiteHeader />
    <main class="mx-auto w-[calc(100%-2rem)] max-w-[1160px] py-12">
      <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-sm text-muted">
        <a href="/" class="hover:text-brand">Home</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-ink">Topics</span>
      </nav>
      <header class="mx-auto mb-12 max-w-3xl text-center">
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-brand">FinYaar learning map</span>
        <h1 class="mt-3 text-[clamp(2.4rem,5vw,4rem)] font-extrabold tracking-[-0.035em] text-ink">{pageH1}</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">{pageH1} helps you start with a pillar, learn its dictionary foundations, and move into practical guides, comparisons, calculators and exam preparation.</p>
      </header>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pillars.map((pillar) => (
          <a href={`/${pillar.slug}/`} class="group rounded-[16px] border border-line bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-brand hover:shadow-[0_8px_24px_rgba(15,23,32,0.07)]">
            <div class="flex items-start justify-between gap-4">
              <span class="material-symbols-outlined rounded-[10px] bg-brand/10 p-2.5 text-brand">{pillar.icon}</span>
              <span class="text-xs font-bold text-muted">{pillar.clusters.length} pages</span>
            </div>
            <h2 class="mt-5 text-xl font-bold text-ink group-hover:text-brand">{pillar.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{pillar.description}</p>
            <p class="mt-4 border-t border-line pt-4 text-xs font-bold uppercase tracking-wide text-brand">{pillar.searchIntent}</p>
          </a>
        ))}
      </div>
      <div class="mt-12"><SeoFaq faqs={faqs} /></div>
    </main>
    <SiteFooter />
  </body>
</html>
