---
import "../styles.css";
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import SeoHead from "../components/SeoHead.astro";
import SeoFaq from "../components/SeoFaq.astro";
import ContextLinks from "../components/ContextLinks.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildGenericFaqs, getKeywordTargetByUrl } from "../lib/seo";

const seo = getKeywordTargetByUrl("/vault/")!;
const benefit = "Explore AI tools for finance professionals, including reusable prompts, spreadsheet templates and audit checklists for reliable workflows.";
const faqs = buildGenericFaqs(seo.primaryKeyword, benefit);
const pageH1 = seo.primaryKeyword.charAt(0).toUpperCase() + seo.primaryKeyword.slice(1);
const breadcrumbs = [{ label: "Home", href: "/" }, { label: pageH1, href: seo.url }];

const eyebrow = "mb-4 text-xs font-bold uppercase tracking-[0.2em] text-brand";
const card = "rounded-[1.25rem] border border-line bg-white p-7 shadow-[0_1px_2px_rgba(15,23,32,0.04)] transition-all hover:-translate-y-1 hover:border-brand/30 hover:shadow-[0_16px_32px_rgba(15,23,32,0.1)]";
const iconBadge = "mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand/10 text-brand";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead target={seo} benefit={benefit} faqs={faqs} />
    <SiteFonts />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="pt-16 pb-12">
        <div class="mx-auto w-[calc(100%-2rem)] max-w-[1160px]">
          <Breadcrumbs items={breadcrumbs} />
          <p class={eyebrow}>Resource vault</p>
          <h1 class="text-[clamp(2.5rem,5vw,4.5rem)] font-extrabold tracking-[-0.03em] text-ink">{pageH1}</h1>
          <p class="mt-4 max-w-[36rem] text-muted">{pageH1} in the Vault include reusable prompts, spreadsheet templates and audit guides for real-world finance work.</p>
        </div>
      </section>

      <section class="py-16">
        <div class="mx-auto grid w-[calc(100%-2rem)] max-w-[1160px] grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <article class={card}>
            <div class={iconBadge}><Icon name="lightbulb" class="h-6 w-6" /></div>
            <h2 class="mt-0 text-xl font-bold text-ink">Prompt library</h2>
            <p class="text-muted">Prebuilt prompts for earnings analysis, valuation review, forecasting, and investor updates.</p>
          </article>
          <article class={card}>
            <div class={iconBadge}><Icon name="layout" class="h-6 w-6" /></div>
            <h2 class="mt-0 text-xl font-bold text-ink">Template library</h2>
            <p class="text-muted">Download working models, valuation trackers, capital allocation checklists, and reporting dashboards.</p>
          </article>
          <article class={card}>
            <div class={iconBadge}><Icon name="clipboard-check" class="h-6 w-6" /></div>
            <h2 class="mt-0 text-xl font-bold text-ink">Audit checklists</h2>
            <p class="text-muted">Follow structured reviews for model integrity, output consistency, and AI-sourced analysis.</p>
          </article>
        </div>
      </section>
      <section class="mx-auto grid w-[calc(100%-2rem)] max-w-[1160px] gap-10 pb-16"><ContextLinks /><SeoFaq faqs={faqs} /></section>
    </main>
    <SiteFooter />
  </body>
</html>
