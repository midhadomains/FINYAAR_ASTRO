---
import "../styles.css";
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getAllPostSlugs, getPostBySlug, formatPostDate } from "../lib/wordpress";

export async function getStaticPaths() {
  const slugs = await getAllPostSlugs();

  return Promise.all(
    slugs.map(async (slug) => ({
      params: { slug },
      props: { post: await getPostBySlug(slug) },
    }))
  );
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect("/blog");
}

const eyebrow = "mb-4 text-xs font-bold uppercase tracking-[0.2em] text-brand";
const category = post.categories[0];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} — FinYaar Finance Blog</title>
    <meta name="description" content={post.excerpt.replace(/<[^>]*>/g, "").trim()} />
    <SiteFonts />
  </head>
  <body>
    <SiteHeader />
    <main>
      <article class="py-16">
        <div class="mx-auto w-[calc(100%-2rem)] max-w-[760px]">
          <a href="/blog" class="mb-6 inline-flex items-center gap-2 font-semibold text-brand">&larr; Back to Blog</a>
          {category && <p class={eyebrow}>{category.name}</p>}
          <h1 class="text-[clamp(2rem,4vw,3.25rem)] font-extrabold tracking-[-0.02em] text-ink">{post.title}</h1>
          <div class="mt-4 flex items-center gap-3 text-[0.95rem] text-muted">
            {post.author && <span class="font-semibold text-ink">{post.author.name}</span>}
            <span>&middot;</span>
            <time datetime={post.date}>{formatPostDate(post.date)}</time>
          </div>

          {post.featuredImage && (
            <img
              src={post.featuredImage.sourceUrl}
              alt={post.featuredImage.altText || post.title}
              class="my-10 w-full rounded-[1.25rem] object-cover"
            />
          )}

          <div class="post-content text-[1.05rem] leading-[1.75] text-ink" set:html={post.content} />
        </div>
      </article>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .post-content :global(p) {
    margin: 0 0 1.5rem;
  }
  .post-content :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  .post-content :global(h3) {
    margin: 2rem 0 1rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .post-content :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.5rem 1.5rem;
    padding: 0;
  }
  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-content :global(img) {
    border-radius: 1.25rem;
    margin: 2rem 0;
    max-width: 100%;
    height: auto;
  }
  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 3px solid var(--color-brand);
    background: var(--color-surface);
    border-radius: 0.5rem;
    color: var(--color-muted);
  }
  .post-content :global(code) {
    background: var(--color-surface);
    padding: 0.15rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.9em;
  }
</style>
