---
import "../../styles.css";
import SiteFonts from "../../components/SiteFonts.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SeoFaq from "../../components/SeoFaq.astro";
import SocialMeta from "../../components/SocialMeta.astro";
import { terms, categoryMap, getRelatedTerms, getTermCategorySlug } from "../../lib/dictionary";
import { getPillarBySlug, getPillarSlugForTerm } from "../../lib/pillars";
import { buildGenericFaqs, buildMetaDescription, buildSeoTitle, faqSchema, getTermSeo } from "../../lib/seo";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  return terms.map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

const { term } = Astro.props;
const termSeo = getTermSeo(term);
const pageH1 = termSeo.primaryKeyword.charAt(0).toUpperCase() + termSeo.primaryKeyword.slice(1);
const openingAnswer = `${pageH1} is ${term.definition.replace(/^[A-Z]/, (letter) => letter.toLowerCase())}`;
const seoTitle = term.seoTitle && term.seoTitle.length <= 60 && term.seoTitle.toLowerCase().includes(termSeo.primaryKeyword.toLowerCase())
  ? term.seoTitle
  : buildSeoTitle(termSeo.primaryKeyword);
const metaDescription = buildMetaDescription(termSeo.primaryKeyword, term.metaDescription ?? term.definition);
const pageFaqs = term.faq?.map((item) => ({ question: item.question, answer: item.answer }))
  ?? buildGenericFaqs(termSeo.primaryKeyword, term.definition);
const category = categoryMap[term.category];
const categoryLabel = term.categoryLabel ?? category.label;
const related = getRelatedTerms(term, 4);
const pillar = getPillarBySlug(getPillarSlugForTerm(term));

const canonicalPath = term.url ?? `/dictionary/${term.slug}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const categoryUrl = new URL(`/dictionary/category/${getTermCategorySlug(term)}/`, canonicalUrl);
const dictionaryUrl = new URL("/dictionary/", canonicalUrl);
const schemaGraph: Record<string, unknown>[] = [
  {
    "@type": "DefinedTerm",
    "@id": `${canonicalUrl.href}#term`,
    name: term.term,
    termCode: term.slug,
    description: term.definition,
    url: canonicalUrl.href,
    inDefinedTermSet: {
      "@type": "DefinedTermSet",
      "@id": `${dictionaryUrl.href}#dictionary`,
      name: "FinYaar Finance Dictionary",
      url: dictionaryUrl.href,
    },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl.href}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", canonicalUrl).href },
      { "@type": "ListItem", position: 2, name: "Dictionary", item: dictionaryUrl.href },
      { "@type": "ListItem", position: 3, name: categoryLabel, item: categoryUrl.href },
      { "@type": "ListItem", position: 4, name: term.term, item: canonicalUrl.href },
    ],
  },
];
schemaGraph.push(faqSchema(pageFaqs, canonicalUrl));
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph }).replaceAll("<", "\\u003c");

const toc = term.lessonToc?.length
  ? [...term.lessonToc, { id: "faq", label: "FAQ" }]
  : [
      { id: "concept", label: "Core Concept" },
      ...(term.formula ? [{ id: "formula", label: "The Formula" }] : []),
      ...(term.example ? [{ id: "example", label: "Worked Example" }] : []),
      ...(term.comparison ? [{ id: "comparison", label: term.comparison.title }] : []),
      ...(term.quiz ? [{ id: "quiz", label: "Self-Test Quiz" }] : []),
      { id: "faq", label: "FAQ" },
    ];

const card14 = "rounded-[14px] border border-line bg-white p-6";
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={termSeo.primaryKeyword} />
    <link rel="canonical" href={canonicalUrl} />
    <SocialMeta title={seoTitle} description={metaDescription} canonicalUrl={canonicalUrl} type="article" />
    <meta property="article:tag" content={termSeo.primaryKeyword} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem("finyaar-theme") === "dark" ? "dark" : "light"; } catch {}
    </script>
    <SiteFonts />
    <style>
      .formula-font {
        font-family: "Times New Roman", serif;
        font-style: italic;
      }
    </style>
    <style is:global>
      :root {
        --dict-grad: linear-gradient(100deg, var(--color-accent) 0%, var(--color-brand) 52%, var(--color-violet) 100%);
      }
      .doc-note {
        border-left: 3px solid var(--color-brand);
        background: var(--color-surface);
        border-radius: 0 14px 14px 0;
        padding: 1.1rem 1.4rem;
      }
      .lesson-body {
        display: grid;
        gap: 1.25rem;
      }
      .lesson-body .section {
        scroll-margin-top: 6rem;
        overflow: hidden;
        border: 1px solid var(--color-line);
        border-radius: 14px;
        background: var(--theme-panel);
      }
      .lesson-body .sec-head {
        display: flex;
        cursor: pointer;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.5rem;
      }
      .lesson-body .sec-head::after {
        content: "−";
        color: var(--color-brand);
        font-size: 1.35rem;
        font-weight: 700;
      }
      .lesson-body .section.collapsed .sec-head::after {
        content: "+";
      }
      .lesson-body .sec-head h2 {
        color: var(--color-ink);
        font-size: 1.15rem;
        font-weight: 800;
      }
      .lesson-body .sec-body {
        display: grid;
        gap: 1rem;
        border-top: 1px solid var(--color-line);
        padding: 1.5rem;
        color: var(--color-muted);
        line-height: 1.75;
      }
      .lesson-body a,
      .lesson-body a:visited {
        border-radius: 4px;
        background: color-mix(in srgb, var(--color-brand) 9%, transparent);
        color: var(--color-brand);
        font-weight: 700;
        text-decoration-line: underline;
        text-decoration-color: color-mix(in srgb, var(--color-brand) 55%, transparent);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
        transition: background-color 0.15s ease, text-decoration-color 0.15s ease;
      }
      .lesson-body a:hover {
        background: color-mix(in srgb, var(--color-brand) 16%, transparent);
        text-decoration-color: currentColor;
      }
      .lesson-body a:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--color-brand) 30%, transparent);
        outline-offset: 2px;
      }
      .lesson-body .section.collapsed .sec-body {
        display: none;
      }
      .lesson-body .sec-body ul {
        display: grid;
        gap: 0.6rem;
        list-style: none;
        margin: 0;
        padding-left: 0;
      }
      .lesson-body .sec-body ul li {
        position: relative;
        padding-left: 1.85rem;
      }
      .lesson-body .sec-body ul li::before {
        content: "✓";
        position: absolute;
        left: 0;
        top: 0.15rem;
        display: grid;
        width: 1.15rem;
        height: 1.15rem;
        place-items: center;
        border-radius: 5px;
        background: var(--color-brand);
        color: white;
        font-size: 0.65rem;
        font-weight: 700;
      }
      .lesson-body .formula .katex {
        font-size: 1.1em;
      }
      .lesson-body .tbl-scroll {
        overflow-x: auto;
        border: 1px solid var(--color-line);
        border-radius: 10px;
      }
      .lesson-body table.data {
        width: 100%;
        min-width: 480px;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.85rem;
      }
      .lesson-body table.data thead {
        background: var(--color-surface);
      }
      .lesson-body table.data th,
      .lesson-body table.data td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--color-line);
      }
      .lesson-body table.data th {
        color: var(--color-ink);
        font-family: var(--font-display);
        font-weight: 700;
      }
      .lesson-body table.data td {
        color: var(--color-muted);
      }
      .lesson-body table.data tbody tr:nth-child(even) td {
        background: var(--color-surface);
      }
      .lesson-body table.data tbody tr:last-child td {
        border-bottom: none;
      }
      .lesson-body table.data td b {
        color: var(--color-brand);
      }
      .lesson-body .worked {
        position: relative;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
        border-radius: 14px;
        background: linear-gradient(180deg, var(--color-accent-soft) 0%, var(--theme-panel) 60%);
      }
      .lesson-body .w-tag {
        display: inline-block;
        border-radius: 0 0 10px 10px;
        background: var(--dict-grad);
        padding: 0.5rem 1rem;
        color: #241606;
        font-family: var(--font-display);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .lesson-body .st-label {
        color: var(--color-brand);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .lesson-body .w-body {
        display: grid;
        gap: 0.9rem;
        padding: 1.25rem 1.25rem 1.5rem;
      }
      .lesson-body .q-stem,
      .lesson-body .qt {
        color: var(--color-ink);
        font-weight: 700;
      }
      .lesson-body .soln {
        display: grid;
        gap: 0.75rem;
        border-left: 3px solid var(--color-brand);
        padding-left: 1rem;
      }
      .lesson-body .selftest {
        display: grid;
        gap: 0.65rem;
        border: 1.5px dashed color-mix(in srgb, var(--color-brand) 55%, transparent);
        border-radius: 14px;
        background: color-mix(in srgb, var(--color-brand) 6%, var(--theme-panel));
        padding: 1.25rem 1.4rem;
      }
      .lesson-body .selftest .q {
        display: grid;
        gap: 0.75rem;
      }
      .lesson-body .show-btn {
        width: fit-content;
        cursor: pointer;
        border: none;
        border-radius: 10px;
        background: var(--dict-grad);
        padding: 0.6rem 1.1rem;
        color: #241606;
        font-family: var(--font-display);
        font-size: 0.85rem;
        font-weight: 700;
      }
      .lesson-body .qa {
        display: none;
        border-radius: 10px;
        border: 1px solid var(--color-line);
        background: var(--theme-panel);
        padding: 0.9rem 1.1rem;
        color: var(--color-muted);
      }
      .lesson-body .q.answer-visible .qa {
        display: block;
      }
      .lesson-body .callout {
        border-left: 3px solid var(--color-accent);
        background: var(--color-accent-soft);
        border-radius: 0 10px 10px 0;
        padding: 0.9rem 1.1rem;
        color: var(--color-ink);
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body class="article-theme">
    <SiteHeader articleTheme />
    <main class="mx-auto w-[calc(100%-2rem)] max-w-[1160px] py-10">
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-sm text-muted">
        <a class="hover:text-brand" href="/dictionary/">Dictionary</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <a href={`/dictionary/category/${getTermCategorySlug(term)}/`} class="hover:text-brand">{categoryLabel}</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-ink">{term.term}</span>
      </nav>

      <header class="mb-10 max-w-[760px]">
        <a href={pillar ? `/${pillar.slug}/` : "/topics/"} class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-brand hover:bg-brand/15">
          <span class="material-symbols-outlined text-[16px]">{category.icon}</span>
          {categoryLabel}
        </a>
        <h1 class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-[-0.02em] text-ink">{pageH1}</h1>

        <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm text-muted">
          <span>By the <b class="font-bold text-ink">FinYaar Editorial Team</b></span>
          <span aria-hidden="true">&middot;</span>
          <span>Reviewed for accuracy against RBI and SEBI</span>
          <span aria-hidden="true">&middot;</span>
          <span>Last reviewed 2026</span>
        </div>

        <p class="doc-note mt-5 text-lg leading-relaxed text-ink">{openingAnswer}</p>
      </header>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Main content -->
        <article class="space-y-8 lg:col-span-8">
          {term.lessonBody ? (
            <div class="lesson-body" set:html={term.lessonBody} />
          ) : (
            <>
          <section id="concept" class="scroll-mt-24 rounded-r-[14px] border-l-4 border-brand bg-brand/5 p-6">
            <h2 class="mb-2 flex items-center gap-2 text-lg font-bold text-brand">
              <span class="material-symbols-outlined">menu_book</span>
              The Core Concept
            </h2>
            <p class="text-base text-ink">{term.definition}</p>
          </section>

          {term.formula && (
            <section id="formula" class={`scroll-mt-24 ${card14}`}>
              <h3 class="mb-6 text-lg font-bold text-ink">The Formula</h3>
              <div class="formula">
                <p class="formula-font text-center text-2xl font-bold">{term.formula.equation}</p>
              </div>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                {term.formula.variables.map((v) => (
                  <div class="flex items-start gap-3 rounded-[10px] border border-line bg-surface p-3">
                    <span class="formula-font font-bold text-brand">{v.symbol}</span>
                    <span class="text-sm text-muted">{v.meaning}</span>
                  </div>
                ))}
              </div>
            </section>
          )}

          {term.example && (
            <section id="example" class={`scroll-mt-24 ${card14}`}>
              <h3 class="mb-3 text-lg font-bold text-ink">Worked Example</h3>
              <p class="mb-5 text-sm text-muted">{term.example.intro}</p>
              <div class="space-y-2">
                {term.example.steps.map((s) => (
                  <div class="flex items-center justify-between gap-4 rounded-[10px] bg-surface px-4 py-3">
                    <div>
                      <p class="text-sm font-bold text-ink">{s.label}</p>
                      <p class="text-xs text-muted">{s.detail}</p>
                    </div>
                    <p class="flex-shrink-0 font-bold text-brand">{s.value}</p>
                  </div>
                ))}
              </div>
              <div class="mt-4 flex items-center gap-3 rounded-[10px] bg-brand/10 p-4">
                <span class="material-symbols-outlined text-brand">insights</span>
                <p class="text-sm font-bold text-ink">{term.example.result}</p>
              </div>
            </section>
          )}

          {term.comparison && (
            <section id="comparison" class="scroll-mt-24">
              <h3 class="mb-4 text-lg font-bold text-ink">{term.comparison.title}</h3>
              <div class="overflow-x-auto rounded-[14px] border border-line bg-white">
                <table class="w-full min-w-[480px] border-collapse text-left">
                  <caption class="sr-only">{term.comparison.title}</caption>
                  <thead class="bg-surface text-sm font-bold text-ink">
                    <tr>
                      <th class="p-4">Feature</th>
                      {term.comparison.columns.map((c) => <th class="p-4">{c}</th>)}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line text-sm">
                    {term.comparison.rows.map((r) => (
                      <tr>
                        <td class="p-4 font-bold text-ink">{r.label}</td>
                        {r.values.map((v) => <td class="p-4 text-muted">{v}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {term.quiz && (
            <section id="quiz" class="scroll-mt-24 rounded-[14px] bg-ink p-6 text-white shadow-[0_4px_20px_rgba(15,23,32,0.15)]">
              <div class="mb-4 flex items-center gap-3">
                <div class="rounded-lg bg-brand p-2">
                  <span class="material-symbols-outlined">quiz</span>
                </div>
                <h3 class="text-lg font-bold">Check Your Understanding</h3>
              </div>
              <p class="mb-5 font-medium text-white/90">{term.quiz.question}</p>
              <div class="quiz-block grid gap-2.5" data-correct-index={term.quiz.correctIndex}>
                {term.quiz.options.map((opt, i) => (
                  <button type="button" data-index={i} class="quiz-option w-full rounded-[10px] border border-white/25 p-3.5 text-left text-sm text-white/90 transition-all hover:bg-white/10">
                    {opt}
                  </button>
                ))}
                <p class="quiz-explanation hidden rounded-[10px] bg-white/10 p-4 text-sm italic text-white/85">{term.quiz.explanation}</p>
              </div>
            </section>
          )}
            </>
          )}

          <SeoFaq faqs={pageFaqs} />

          <p class="border-t border-line pt-6 text-xs leading-relaxed text-muted">
            Educational content only — FinYaar Finance does not provide investment, legal, or tax advice. Reviewed against FinYaar's practitioner curriculum; always confirm figures against primary sources before relying on them professionally.
          </p>
        </article>

        <!-- Sidebar -->
        <aside class="space-y-5 lg:col-span-4 lg:h-fit lg:sticky lg:top-24">
          {pillar && (
            <a href={`/${pillar.slug}/`} class="block rounded-[14px] bg-ink p-6 text-white transition-transform hover:-translate-y-0.5">
              <span class="material-symbols-outlined text-accent-soft">hub</span>
              <p class="mt-3 text-xs font-bold uppercase tracking-wide text-white/60">Explore the pillar</p>
              <h2 class="mt-1 text-lg font-bold">{pillar.title}</h2>
              <p class="mt-2 text-sm text-white/75">Guides, comparisons, calculators, and related dictionary terms.</p>
            </a>
          )}
          <nav class={card14}>
            <p class="mb-3 text-xs font-bold uppercase tracking-wide text-brand">On this page</p>
            <ul class="space-y-2.5 text-sm text-muted">
              {toc.map((item) => (
                <li>
                  <a class="flex items-center gap-2 hover:text-brand" href={`#${item.id}`}>
                    <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-line"></span>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="rounded-[14px] bg-surface p-6">
            <p class="mb-3 text-xs font-bold uppercase tracking-wide text-muted">Related Terms</p>
            <div class="space-y-3">
              {related.map((r) => (
                <a href={`/dictionary/${r.slug}/`} data-related-term class="group block rounded-[10px] border border-line bg-white p-3 transition-colors hover:border-brand">
                  <p class="text-sm font-bold text-ink group-hover:text-brand">{r.term}</p>
                  <p class="mt-1 line-clamp-1 text-xs text-muted">{r.definition}</p>
                </a>
              ))}
            </div>
          </div>

        </aside>
      </div>
    </main>
    <SiteFooter />

    <script>
      document.querySelectorAll(".lesson-body .sec-head").forEach((heading) => {
        heading.setAttribute("role", "button");
        heading.setAttribute("tabindex", "0");
        const toggle = () => heading.closest(".section")?.classList.toggle("collapsed");
        heading.addEventListener("click", toggle);
        heading.addEventListener("keydown", (event) => {
          if (event instanceof KeyboardEvent && (event.key === "Enter" || event.key === " ")) {
            event.preventDefault();
            toggle();
          }
        });
      });

      document.querySelectorAll(".lesson-body .show-btn").forEach((button) => {
        button.addEventListener("click", () => {
          const question = button.closest(".q");
          question?.classList.toggle("answer-visible");
          button.textContent = question?.classList.contains("answer-visible") ? "Hide answer" : "Show answer";
        });
      });

      document.querySelectorAll(".quiz-block").forEach((block) => {
        const correctIndex = Number(block.getAttribute("data-correct-index"));
        const buttons = block.querySelectorAll(".quiz-option");
        const explanation = block.querySelector(".quiz-explanation");
        let answered = false;

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            if (answered) return;
            answered = true;
            const clickedIndex = Number(btn.getAttribute("data-index"));

            buttons.forEach((b) => {
              const i = Number(b.getAttribute("data-index"));
              if (i === correctIndex) {
                b.classList.add("bg-brand/20", "border-brand");
              } else if (i === clickedIndex) {
                b.classList.add("bg-red-500/15", "border-red-400");
              } else {
                b.classList.add("opacity-50");
              }
            });

            explanation?.classList.remove("hidden");
          });
        });
      });
    </script>
  </body>
</html>
