---
import "../styles.css";
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import SeoHead from "../components/SeoHead.astro";
import SeoFaq from "../components/SeoFaq.astro";
import ContextLinks from "../components/ContextLinks.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getKeywordTargetByUrl, type SeoFaq as SeoFaqItem } from "../lib/seo";

const seo = getKeywordTargetByUrl("/vault/")!;
const benefit = "Explore audit-first AI finance prompts, review checklists, and reusable workflow templates for modelling, research, FP&A, and transaction work.";
const pageH1 = "AI Finance Vault";
const breadcrumbs = [{ label: "Home", href: "/" }, { label: pageH1, href: seo.url }];
const faqs: SeoFaqItem[] = [
  {
    question: "What is the AI Finance Vault?",
    answer: "The AI Finance Vault is a practical library of prompts, workflow templates, and review checklists designed for common finance tasks.",
  },
  {
    question: "Who is the AI Finance Vault for?",
    answer: "It is designed for analysts, finance students, and professionals working in modelling, valuation, investment research, FP&A, and transaction-related roles.",
  },
  {
    question: "Does AI replace financial review and judgement?",
    answer: "No. Every workflow is designed around human review, source checking, reconciliation, and professional judgement before an output is used.",
  },
];

const workflows = [
  {
    icon: "chart-bar",
    title: "Modelling and valuation",
    description: "Structure assumptions, challenge forecasts, review model logic, and document valuation outputs.",
  },
  {
    icon: "search",
    title: "Research and diligence",
    description: "Turn source material into organised questions, evidence logs, company summaries, and review-ready notes.",
  },
  {
    icon: "calendar",
    title: "FP&A workflows",
    description: "Support variance analysis, management reporting, planning narratives, and recurring finance-team tasks.",
  },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead target={seo} benefit={benefit} faqs={faqs} />
    <SiteFonts />
  </head>
  <body class="hub-dark">
    <SiteHeader />
    <main>
      <section class="border-b border-line bg-white py-16">
        <div class="mx-auto w-[calc(100%-2rem)] max-w-[1160px]">
          <Breadcrumbs items={breadcrumbs} />
          <div class="grid gap-10 lg:grid-cols-[1fr_360px] lg:items-center">
            <div class="max-w-3xl">
              <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-brand">Prompts and workflows</p>
              <h1 class="text-[clamp(2.5rem,5vw,4.5rem)] font-extrabold tracking-[-0.03em] text-ink">{pageH1}</h1>
              <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{benefit}</p>
              <a href="/contact/" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-3 font-bold text-white transition-transform hover:-translate-y-0.5">
                Request Vault access
                <span class="material-symbols-outlined text-[19px]">arrow_forward</span>
              </a>
            </div>
            <div class="rounded-[20px] bg-ink p-7 text-white">
              <span class="material-symbols-outlined text-3xl text-accent-soft">verified_user</span>
              <h2 class="mt-4 text-2xl font-extrabold">Audit-first by design</h2>
              <p class="mt-3 leading-relaxed text-white/75">The workflows pair every AI-assisted step with source checks, reconciliations, and a clear human-review point.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16">
        <div class="mx-auto w-[calc(100%-2rem)] max-w-[1160px]">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand">Inside the Vault</p>
          <h2 class="mt-2 max-w-2xl text-3xl font-extrabold text-ink">Reusable tools for real finance work</h2>
          <div class="mt-7 grid gap-5 md:grid-cols-3">
            {workflows.map((workflow) => (
              <article class="rounded-[16px] border border-line bg-white p-6">
                <div class="mb-4 inline-flex size-11 items-center justify-center rounded-xl bg-brand/10 text-brand">
                  <Icon name={workflow.icon} class="h-6 w-6" />
                </div>
                <h3 class="text-xl font-bold text-ink">{workflow.title}</h3>
                <p class="mt-3 leading-relaxed text-muted">{workflow.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="mx-auto grid w-[calc(100%-2rem)] max-w-[1160px] gap-10 pb-16">
        <ContextLinks />
        <SeoFaq faqs={faqs} />
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
