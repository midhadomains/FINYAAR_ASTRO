---
import "../../../styles.css";
import SiteFonts from "../../../components/SiteFonts.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SeoFaq from "../../../components/SeoFaq.astro";
import {
  dictionaryCategories,
  getTermsByDictionaryCategory,
  type DictionaryCategory,
} from "../../../lib/dictionary";
import { getPillarBySlug, getPillarSlugForTerm } from "../../../lib/pillars";
import { buildGenericFaqs, buildMetaDescription, buildSeoTitle, faqSchema, getCategorySeo } from "../../../lib/seo";

interface Props {
  category: DictionaryCategory;
}

export function getStaticPaths() {
  return dictionaryCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as Props;
const seo = getCategorySeo(category);
const seoTitle = buildSeoTitle(seo.primaryKeyword);
const metaDescription = buildMetaDescription(seo.primaryKeyword, category.description);
const pageH1 = seo.primaryKeyword.charAt(0).toUpperCase() + seo.primaryKeyword.slice(1);
const openingAnswer = `${pageH1} is a collection that ${category.description.charAt(0).toLowerCase()}${category.description.slice(1)}`;
const faqs = buildGenericFaqs(seo.primaryKeyword, category.description);
const categoryTerms = getTermsByDictionaryCategory(category.slug);
const canonicalUrl = new URL(`/dictionary/category/${category.slug}/`, Astro.site ?? Astro.url.origin);
const pillar = categoryTerms[0] ? getPillarBySlug(getPillarSlugForTerm(categoryTerms[0])) : undefined;
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl.href}#collection`,
      url: canonicalUrl.href,
      name: `${category.label} Dictionary`,
      description: category.description,
      hasPart: categoryTerms.map((term) => ({
        "@type": "DefinedTerm",
        name: term.term,
        url: new URL(`/dictionary/${term.slug}/`, canonicalUrl).href,
      })),
    },
    faqSchema(faqs, canonicalUrl),
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl.href}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", canonicalUrl).href },
        { "@type": "ListItem", position: 2, name: "Dictionary", item: new URL("/dictionary/", canonicalUrl).href },
        { "@type": "ListItem", position: 3, name: category.label, item: canonicalUrl.href },
      ],
    },
  ],
}).replaceAll("<", "\\u003c");
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={seo.primaryKeyword} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={schema} />
    <SiteFonts />
  </head>
  <body class="hub-dark">
    <SiteHeader />
    <main class="mx-auto w-[calc(100%-2rem)] max-w-[1160px] py-10">
      <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand">Home</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <a href="/dictionary/" class="hover:text-brand">Dictionary</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-ink">{category.label}</span>
      </nav>

      <header class="rounded-[18px] border border-line bg-white p-7 sm:p-10">
        <span class="inline-flex items-center gap-2 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-brand">
          <span class="material-symbols-outlined text-[17px]">{category.icon}</span>
          Dictionary category
        </span>
        <h1 class="mt-5 text-[clamp(2.25rem,5vw,3.75rem)] font-extrabold tracking-[-0.035em] text-ink">{pageH1}</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{openingAnswer}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-surface px-3 py-1.5 text-sm font-bold text-ink">{categoryTerms.length} terms</span>
          {pillar && <a href={`/${pillar.slug}/`} class="rounded-full bg-brand px-3 py-1.5 text-sm font-bold text-white hover:bg-brand-dark">Explore the {pillar.title} pillar</a>}
        </div>
      </header>

      <section class="mt-10">
        <div class="mb-5 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand">A–Z</p>
            <h2 class="mt-2 text-2xl font-extrabold text-ink">Terms in this category</h2>
          </div>
          <a href="/dictionary/" class="text-sm font-bold text-brand hover:underline">All dictionary terms</a>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {categoryTerms.map((term) => (
            <a href={`/dictionary/${term.slug}/`} class="group rounded-[14px] border border-line bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand hover:shadow-[0_6px_20px_rgba(15,23,32,0.06)]">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-bold text-ink group-hover:text-brand">{term.term}</h3>
                {term.lessonBody && <span class="rounded-md bg-brand/10 px-2 py-1 text-[0.65rem] font-bold uppercase tracking-wide text-brand">Lesson</span>}
              </div>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{term.definition}</p>
            </a>
          ))}
        </div>
      </section>
      <div class="mt-12"><SeoFaq faqs={faqs} /></div>
    </main>
    <SiteFooter />
  </body>
</html>
