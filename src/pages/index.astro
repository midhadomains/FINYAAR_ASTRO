---
import "../styles.css";
import SeoHead from "../components/SeoHead.astro";
import { terms } from "../lib/dictionary";
import { pillars } from "../lib/pillars";
import { getKeywordTargetByUrl, organizationSchema, websiteSchema } from "../lib/seo";

const seo = getKeywordTargetByUrl("/")!;
const benefit = "Understand finance in plain English with simple definitions, formulas, worked rupee examples, and India-focused guides.";
const faqs = [
  { question: "Wait, what is FinYaar exactly?", answer: "India's finance dictionary with a personality. Every money term is explained in plain English, with formulas, worked examples, and practical context." },
  { question: "Is FinYaar really free?", answer: "Yes. The dictionary and learning guides are free to read, with no paywall or sign-up required." },
  { question: "Who is FinYaar for?", answer: "Anyone learning money in India: first-time investors, finance students, working professionals, and people preparing for finance careers." },
  { question: "Why does FinYaar use Hinglish?", answer: "Because that is how many Indians naturally talk about money. We use it lightly to make difficult ideas feel familiar without sacrificing accuracy." },
];
const canonical = new URL("/", Astro.site ?? Astro.url.origin);
const schemas = [organizationSchema(canonical), websiteSchema(canonical)];

const homepageTopicSlugs = [
  "personal-finance",
  "banking-savings-deposits",
  "loans-credit-debt",
  "investing-basics",
  "stock-market-equities",
  "mutual-funds-sip-etfs",
  "economics-macro",
  "taxation-india",
];
const topicCards = homepageTopicSlugs
  .map((slug) => pillars.find((pillar) => pillar.slug === slug))
  .filter((pillar) => pillar !== undefined);
const topicEmoji = ["₹", "🏦", "💳", "🌱", "📈", "🧺", "🌍", "%"];
const featuredTerms = [
  ["SIP", "sip-systematic-investment-plan", "systematic investment plan"],
  ["Mutual Fund", "mutual-fund", ""],
  ["Compound Interest", "compound-interest", ""],
  ["Fixed Deposit", "fixed-deposit", ""],
  ["Credit Score", "credit-score-cibil", "CIBIL"],
  ["EMI", "emi", ""],
  ["Index Fund", "index-fund", ""],
  ["IPO", "ipo", ""],
  ["ETF", "etf", ""],
  ["EBITDA", "ebitda", ""],
  ["P/E Ratio", "pe-ratio", ""],
  ["Beta", "beta", ""],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead target={seo} benefit={benefit} faqs={faqs} additionalSchema={schemas} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="home-page">
    <header class="site-nav">
      <div class="wrap nav-inner">
        <a class="logo" href="/" aria-label="FinYaar home"><strong>Fin</strong><span>Yaar</span><i></i></a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/dictionary/">Dictionary</a>
          <a href="/topics/">Topics</a>
          <a href="/courses/">Courses</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
        </nav>
        <a class="button primary nav-cta" href="/dictionary/">Browse A–Z <span aria-hidden="true">→</span></a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <nav>
            <a href="/dictionary/">Dictionary</a><a href="/topics/">Topics</a><a href="/courses/">Courses</a><a href="/blog/">Blog</a><a href="/about/">About</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="glow glow-coral"></div><div class="glow glow-violet"></div>
        <div class="wrap hero-wrap">
          <nav class="sr-only" aria-label="Breadcrumb"><a href="/">Home</a></nav>
          <aside class="word-card" aria-label="Term of the day">
            <span class="card-kicker">Aaj ka shabd</span>
            <h2>SIP</h2>
            <p>Investing a fixed amount every month instead of one big lump sum. Chhote kadam, badi wealth.</p>
            <a href="/dictionary/sip-systematic-investment-plan/">Mutual Funds & SIP →</a>
          </aside>
          <div class="hero-copy">
            <p class="status-chip"><span></span> India's finance dictionary — free, forever</p>
            <h1><span class="sr-only">Finance courses and dictionary India. </span>Finance, finally samjhaaya<br />by a <span class="swap" aria-hidden="true"><span id="hero-word">yaar.</span></span></h1>
            <p class="hero-lead">Every money word, every formula, every “wait, what does that even mean?” — <strong>broken down in plain English with real rupee examples.</strong> No jargon. No gyaan. Just clarity, yaar.</p>
            <form class="hero-search" action="/dictionary" method="get">
              <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <label class="sr-only" for="home-search">Search the finance dictionary</label>
              <input id="home-search" name="q" autocomplete="off" placeholder="Type a word you nodded along to but never got…" />
              <button class="button primary" type="submit">Samjhao</button>
            </form>
            <div class="hero-actions">
              <a class="button ghost" href="/topics/">Pick a topic <span aria-hidden="true">→</span></a>
              <a class="button ghost" href="/courses/">Build career skills <span aria-hidden="true">→</span></a>
            </div>
            <p class="hero-note">{terms.length}+ terms live and growing · rupees, not dollars · India-focused</p>
          </div>
        </div>
      </section>

      <section class="trust-strip" aria-label="FinYaar features">
        <div class="wrap strip-inner">
          <span><strong>Plain English</strong>, always first</span><i>•</i>
          <span>Worked examples in <strong>₹</strong></span><i>•</i>
          <span><strong>India-focused</strong> context</span><i>•</i>
          <span><strong>Career-ready</strong> concepts</span><i>•</i>
          <span>Every term <strong>interlinked</strong></span>
        </div>
      </section>

      <section class="section paper">
        <div class="wrap">
          <div class="section-heading">
            <p class="eyebrow">Not a textbook</p>
            <h2>It explains money the way a smart friend would.</h2>
            <p>You know that one friend who can explain anything without making you feel stupid? That is the entire brief. One line to get it. The rest to nail it.</p>
          </div>
          <div class="feature-grid">
            <article><span class="feature-icon">🗣️</span><h3>Plain English first</h3><p>One clear sentence before anything else. Get the idea without decoding a wall of jargon.</p></article>
            <article><span class="feature-icon rupee">₹</span><h3>Examples in rupees</h3><p>SIPs, FDs, EMIs, and markets. Real Indian numbers instead of generic dollar examples.</p></article>
            <article><span class="feature-icon">🧮</span><h3>The actual math</h3><p>Formulas rendered clearly and worked out step by step. No hand-waving, no “trust me.”</p></article>
            <article><span class="feature-icon">🔗</span><h3>Everything connects</h3><p>Meet an unfamiliar term inside an entry? Follow it and keep learning at your own pace.</p></article>
          </div>
        </div>
      </section>

      <section class="section paper anatomy">
        <div class="wrap">
          <div class="section-heading compact"><p class="eyebrow">Anatomy of an entry</p><h2>Four layers. Zero fluff.</h2></div>
          <div class="steps">
            <article><span>1</span><h3>The one-liner</h3><p>What it means in a single breath. Clear enough to remember.</p></article>
            <article><span>2</span><h3>The formula</h3><p>Where there is one, explained in notation and ordinary words.</p></article>
            <article><span>3</span><h3>Worked in ₹</h3><p>A practical example using numbers you can actually relate to.</p></article>
            <article><span>4</span><h3>Test & FAQs</h3><p>A quick knowledge check and the questions people really ask.</p></article>
          </div>
        </div>
      </section>

      <section class="section warm" id="topics">
        <div class="wrap">
          <div class="section-heading"><p class="eyebrow">Start anywhere</p><h2>Pick your paisa problem.</h2><p>Whatever money question is on your mind, there is a learning path for it.</p></div>
          <div class="topic-grid">
            {topicCards.map((topic, index) => (
              <a class="topic-card" href={`/${topic.slug}/`}>
                <span>{topicEmoji[index]}</span><div><h3>{topic.title}</h3><p>{topic.description}</p></div><b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
          <a class="button ink-outline" href="/topics/">See all topics <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="section paper">
        <div class="wrap">
          <div class="section-heading compact"><p class="eyebrow">Sabse zyada poocha gaya</p><h2>The words India keeps Googling.</h2></div>
          <div class="term-cloud">
            {featuredTerms.map(([label, slug, note]) => <a href={`/dictionary/${slug}/`}>{label}{note && <span> · {note}</span>}</a>)}
          </div>
        </div>
      </section>

      <section class="section paper career-section">
        <div class="wrap">
          <div class="career-band">
            <div class="glow glow-coral"></div>
            <div class="career-copy"><p class="eyebrow amber">Serious mode</p><h2>Finance career? We speak that language too.</h2><p>Take the same clarity into modeling, valuation, banking, FP&A, and AI-enabled finance workflows—with practical, case-based learning.</p>
              <div class="career-pills"><a href="/courses/">Financial Modeling<small>Cases, formulas, Excel</small></a><a href="/courses/">Investment Banking<small>Deals, comps, pitchbooks</small></a><a href="/vault/">AI Finance Vault<small>Prompts and workflows</small></a></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section warm">
        <div class="wrap accuracy-grid">
          <div><p class="eyebrow">Simple, par sahi</p><h2>Friendly on top. Rigorous underneath.</h2>
            <ul><li><span>✓</span><p>Definitions are written for <strong>clarity and practical use</strong>, not keyword stuffing.</p></li><li><span>✓</span><p>Money is serious, so we choose <strong>clear and correct over clever</strong>.</p></li><li><span>✓</span><p>Entries connect to formulas, examples, FAQs, and <strong>related concepts</strong>.</p></li><li><span>✓</span><p>Built for Indian learners, from <strong>everyday money to professional finance</strong>.</p></li></ul>
          </div>
          <blockquote><p>“Paisa serious hai. Seekhna itna serious nahi hona chahiye.”</p><footer>The one line the whole site is built around.</footer></blockquote>
        </div>
      </section>

      <section class="section paper faq-section" id="faq">
        <div class="wrap">
          <div class="section-heading centered compact"><p class="eyebrow">Chhoti-moti doubts</p><h2>Questions, yaar?</h2></div>
          <div class="faq-list">
            {faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <section class="newsletter">
          <div class="glow glow-violet"></div><div class="newsletter-inner"><p class="eyebrow amber">Learn in small bites</p><h2>One useful word at a time.</h2><p>Start with the dictionary, follow the related terms, and make finance make sense.</p><a class="button primary" href="/dictionary/">Start exploring <span aria-hidden="true">→</span></a></div>
        </section>
        <div class="footer-grid">
          <div class="footer-brand"><a class="logo" href="/"><strong>Fin</strong><span>Yaar</span><i></i></a><p>The friend who finally makes money make sense. Plain-English finance definitions, guides, and practical learning.</p></div>
          <div><h3>Dictionary</h3><a href="/dictionary/">A–Z index</a><a href="/dictionary/">Popular terms</a><a href="/topics/">Topic hubs</a></div>
          <div><h3>Learn</h3><a href="/topics/">Topics</a><a href="/courses/">Courses</a><a href="/vault/">AI Finance Vault</a><a href="/blog/">Blog</a></div>
          <div><h3>FinYaar</h3><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/about/">Editorial standards</a></div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} FinYaar. Made in India, for India.</span><span><a href="/">Privacy</a><a href="/">Terms</a><a href="/">Disclaimer</a></span></div>
      </div>
    </footer>
    <script>
      (() => {
        const element = document.getElementById("hero-word");
        if (!element) return;

        const words = ["yaar.", "friend.", "human.", "dost."];
        let index = 0;

        const showNextWord = () => {
          element.textContent = words[index];
          index = (index + 1) % words.length;

          if (typeof element.animate !== "function") {
            window.setTimeout(showNextWord, 1500);
            return;
          }

          const animation = element.animate(
            [
              { opacity: 0, transform: "translateY(14px)", offset: 0 },
              { opacity: 1, transform: "translateY(0)", offset: 0.24 },
              { opacity: 1, transform: "translateY(0)", offset: 0.76 },
              { opacity: 0, transform: "translateY(-14px)", offset: 1 },
            ],
            { duration: 1500, easing: "linear", fill: "both" },
          );
          animation.finished.then(showNextWord).catch(() => {});
        };

        showNextWord();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root{--home-ink:#0b0c10;--home-ink-2:#121319;--home-card:#1a1c25;--home-line:rgba(255,255,255,.09);--home-paper:#fbf9f4;--home-warm:#f3efe6;--home-paper-line:#e7e1d4;--home-text:#f5f2ea;--home-muted:#a7a9b6;--home-paper-text:#14151b;--home-paper-muted:#5c5e6b;--amber:#ffc24b;--coral:#ff6b5e;--violet:#a483ff;--mint:#4ade9e;--fin-grad:linear-gradient(100deg,#ffc24b 0%,#ff6b5e 48%,#a483ff 100%)}
  *{box-sizing:border-box}.home-page{margin:0;background:var(--home-ink);color:var(--home-text);font-family:Inter,system-ui,sans-serif;line-height:1.55;-webkit-font-smoothing:antialiased}.home-page h1,.home-page h2,.home-page h3,.home-page .button,.home-page .logo{font-family:"Space Grotesk",Inter,sans-serif}.home-page h1,.home-page h2,.home-page h3{letter-spacing:-.025em;line-height:1.06}.home-page a{text-decoration:none}.wrap{width:min(1180px,calc(100% - 48px));margin-inline:auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .site-nav{position:sticky;top:0;z-index:50;border-bottom:1px solid var(--home-line);background:rgba(11,12,16,.78);backdrop-filter:blur(16px)}.nav-inner{position:relative;height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px}.logo{color:var(--home-text);font-size:23px;font-weight:700;letter-spacing:-.04em}.logo strong{font-weight:700}.logo span{background:var(--fin-grad);background-clip:text;color:transparent}.logo i{display:inline-block;width:7px;height:7px;margin-left:2px;border-radius:50%;background:var(--coral);transform:translateY(-8px)}.nav-links{position:absolute;left:50%;display:flex;gap:29px;margin:0;transform:translateX(-50%)}.nav-links a{color:var(--home-muted);font-size:14px;font-weight:600;transition:color .2s}.nav-links a:hover{color:var(--home-text)}.button{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:11px 18px;font-size:14px;font-weight:700;transition:transform .2s,filter .2s,border-color .2s;background:none;cursor:pointer}.button:hover{transform:translateY(-2px)}.primary{color:#1b110d;background:var(--fin-grad);box-shadow:0 10px 30px -16px rgba(255,107,94,.7)}.primary:hover{filter:brightness(1.07)}.mobile-menu{display:none;position:relative}.mobile-menu summary{display:grid;gap:4px;list-style:none;cursor:pointer}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:24px;height:2px;background:white}.mobile-menu nav{position:absolute;right:0;top:38px;display:grid;width:210px;padding:10px;border:1px solid var(--home-line);border-radius:14px;background:var(--home-card);box-shadow:0 20px 50px rgba(0,0,0,.35)}.mobile-menu nav a{padding:11px 12px;color:var(--home-text);font-weight:600;border-radius:8px}.mobile-menu nav a:hover{background:rgba(255,255,255,.06)}
  .hero{position:relative;overflow:hidden;padding:82px 0 96px}.hero-wrap{position:relative;min-height:490px;display:flex;align-items:center}.glow{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none}.glow-coral{width:520px;height:520px;top:-220px;right:-150px;background:radial-gradient(circle,var(--coral),transparent 65%);opacity:.5}.glow-violet{width:480px;height:480px;left:-160px;bottom:-270px;background:radial-gradient(circle,var(--violet),transparent 65%);opacity:.34}.hero-copy{position:relative;z-index:2;max-width:840px}.status-chip{display:inline-flex;align-items:center;gap:9px;margin:0 0 26px;padding:7px 14px;border:1px solid var(--home-line);border-radius:999px;background:rgba(255,255,255,.06);font-size:13px;font-weight:500}.status-chip span{width:7px;height:7px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 4px rgba(74,222,158,.17)}.hero h1{margin:0;font-size:clamp(42px,6.25vw,74px);font-weight:700}.swap{display:inline-block;min-width:6.25ch;height:1.18em;overflow:visible;vertical-align:-.04em;white-space:nowrap}.swap span{display:inline-block;line-height:1.08;background:var(--fin-grad);-webkit-background-clip:text;background-clip:text;color:transparent;will-change:transform,opacity}.hero-lead{max-width:650px;margin:25px 0 34px;color:var(--home-muted);font-size:clamp(16px,2vw,19px)}.hero-lead strong{color:var(--home-text)}.hero-search{display:flex;align-items:center;gap:12px;max-width:580px;padding:8px 8px 8px 18px;border-radius:16px;background:white;color:#8b8e9b;box-shadow:0 24px 65px -24px rgba(255,107,94,.62)}.hero-search input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--home-paper-text);font:500 15px Inter}.hero-search input::placeholder{color:#9799a5}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}.ghost{border:1px solid var(--home-line);color:var(--home-text)}.ghost:hover{border-color:rgba(255,255,255,.32)}.hero-note{margin:18px 0 0;color:var(--home-muted);font-size:13px}.word-card{position:absolute;z-index:2;right:0;top:70px;width:274px;padding:21px;border:1px solid var(--home-line);border-radius:22px;background:var(--home-card);box-shadow:0 30px 80px -30px #000;transform:rotate(2.5deg);animation:card-float 6s ease-in-out infinite}@keyframes card-float{50%{transform:translateY(-12px) rotate(2.5deg)}}.card-kicker{color:var(--amber);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.word-card h2{margin:7px 0 9px;font-size:28px}.word-card p{margin:0;color:var(--home-muted);font-size:13.5px}.word-card a{display:inline-block;margin-top:15px;padding:5px 10px;border-radius:8px;background:rgba(74,222,158,.1);color:var(--mint);font-size:12px;font-weight:600}
  .trust-strip{border-block:1px solid var(--home-line);background:var(--home-ink-2)}.strip-inner{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:14px 36px;padding-block:20px;color:var(--home-muted);font-size:13.5px}.strip-inner strong{color:var(--home-text)}.strip-inner i{color:var(--coral);font-style:normal}.section{padding:90px 0}.paper{background:var(--home-paper);color:var(--home-paper-text)}.warm{background:var(--home-warm);color:var(--home-paper-text)}.section-heading{max-width:680px;margin-bottom:48px}.section-heading.compact{margin-bottom:38px}.section-heading.centered{margin-inline:auto;text-align:center}.eyebrow{margin:0 0 14px;color:var(--coral);font:700 12px "Space Grotesk";letter-spacing:.15em;text-transform:uppercase}.section-heading h2,.accuracy-grid h2{margin:0;font-size:clamp(31px,4.2vw,47px);font-weight:700}.section-heading>p:last-child{margin:15px 0 0;color:var(--home-paper-muted);font-size:17px}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.feature-grid article{padding:26px;border:1px solid var(--home-paper-line);border-radius:22px;background:white;transition:.22s}.feature-grid article:hover{transform:translateY(-5px);box-shadow:0 24px 50px -30px rgba(0,0,0,.28)}.feature-icon{display:grid;width:46px;height:46px;place-items:center;margin-bottom:17px;border-radius:13px;background:var(--home-warm);font-size:22px}.feature-icon.rupee{font-size:21px;font-weight:800}.feature-grid h3,.steps h3{margin:0 0 8px;font-size:19px}.feature-grid p,.steps p{margin:0;color:var(--home-paper-muted);font-size:14px}.anatomy{padding-top:0}.steps{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid var(--home-paper-line);border-radius:22px;background:white}.steps article{padding:30px 26px;border-right:1px solid var(--home-paper-line)}.steps article:last-child{border:0}.steps article>span{display:grid;width:31px;height:31px;place-items:center;margin-bottom:17px;border-radius:9px;background:var(--home-paper-text);color:white;font:700 14px "Space Grotesk"}
  .topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:28px}.topic-card{position:relative;display:flex;align-items:flex-start;gap:15px;padding:22px;border:1px solid var(--home-paper-line);border-radius:17px;background:white;color:var(--home-paper-text);transition:.2s}.topic-card:hover{border-color:var(--coral);transform:translateY(-4px)}.topic-card>span{font-size:24px;line-height:1}.topic-card h3{margin:0 20px 5px 0;font-size:17px}.topic-card p{margin:0;color:var(--home-paper-muted);font-size:13px}.topic-card b{position:absolute;right:18px;top:18px;color:#b1aba0;font-size:15px}.ink-outline{border:1px solid var(--home-paper-line);color:var(--home-paper-text)}.ink-outline:hover{border-color:var(--home-paper-text)}.term-cloud{display:flex;flex-wrap:wrap;gap:12px}.term-cloud a{padding:11px 19px;border:1px solid var(--home-paper-line);border-radius:999px;background:white;color:var(--home-paper-text);font:700 15px "Space Grotesk";transition:.18s}.term-cloud a span{color:var(--coral);font-weight:500}.term-cloud a:hover{color:white;background:var(--home-paper-text);transform:translateY(-2px)}.term-cloud a:hover span{color:var(--amber)}
