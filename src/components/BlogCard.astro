---
import type { BlogPostSummary } from "../lib/wordpress";
import { formatPostDate, stripHtml } from "../lib/wordpress";

interface Props {
  post: BlogPostSummary;
}

const { post } = Astro.props;
const category = post.categories[0];
---
<article class="group overflow-hidden rounded-[1.25rem] border border-line bg-white shadow-[0_1px_2px_rgba(11,31,75,0.04)] transition-all hover:-translate-y-1 hover:border-brand/30 hover:shadow-[0_16px_32px_rgba(11,31,75,0.1)]">
  <a href={`/${post.slug}`} class="block">
    {post.featuredImage && (
      <img
        src={post.featuredImage.sourceUrl}
        alt={post.featuredImage.altText || post.title}
        class="h-[200px] w-full object-cover"
        loading="lazy"
      />
    )}
    <div class="p-7">
      {category && (
        <span class="mb-4 inline-flex items-center rounded-full bg-brand/10 px-[0.8rem] py-[0.4rem] text-[0.85rem] font-bold text-brand">
          {category.name}
        </span>
      )}
      <h2 class="mt-0 mb-2 text-xl font-bold text-ink group-hover:text-brand">{post.title}</h2>
      <p class="text-muted">{stripHtml(post.excerpt)}</p>
      <div class="mt-5 flex items-center gap-3 text-[0.9rem] text-muted">
        {post.author && <span class="font-semibold text-ink">{post.author.name}</span>}
        <span>&middot;</span>
        <time datetime={post.date}>{formatPostDate(post.date)}</time>
      </div>
    </div>
  </a>
</article>
