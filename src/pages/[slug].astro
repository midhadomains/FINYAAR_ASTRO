---
import PillarHubPage from "../components/PillarHubPage.astro";
import { pillars, type Pillar } from "../lib/pillars";

interface PageProps {
  pillar: Pillar;
}

export function getStaticPaths() {
  return pillars.map((pillar) => ({ params: { slug: pillar.slug }, props: { pillar } }));
}

const { pillar } = Astro.props as PageProps;
---
<PillarHubPage pillar={pillar} />
