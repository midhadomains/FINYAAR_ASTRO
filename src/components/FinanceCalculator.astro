---
interface Props {
  slug: string;
}

const { slug } = Astro.props;

const configs: Record<string, { fields: { key: string; label: string; value: number; step?: string }[]; result: string }> = {
  "net-worth-calculator": {
    fields: [
      { key: "assets", label: "Total assets (₹)", value: 1000000 },
      { key: "liabilities", label: "Total liabilities (₹)", value: 300000 },
    ],
    result: "Estimated net worth",
  },
  "fd-maturity-calculator": {
    fields: [
      { key: "principal", label: "Deposit amount (₹)", value: 100000 },
      { key: "rate", label: "Annual interest rate (%)", value: 7, step: "0.1" },
      { key: "years", label: "Tenure (years)", value: 5, step: "0.5" },
    ],
    result: "Estimated maturity value",
  },
  "investment-growth-calculator": {
    fields: [
      { key: "principal", label: "Starting investment (₹)", value: 100000 },
      { key: "rate", label: "Expected annual return (%)", value: 10, step: "0.1" },
      { key: "years", label: "Investment period (years)", value: 10, step: "0.5" },
    ],
    result: "Estimated future value",
  },
  "emi-calculator": {
    fields: [
      { key: "principal", label: "Loan amount (₹)", value: 1000000 },
      { key: "rate", label: "Annual interest rate (%)", value: 9, step: "0.1" },
      { key: "years", label: "Loan tenure (years)", value: 10, step: "0.5" },
    ],
    result: "Estimated monthly EMI",
  },
  "bond-yield-calculator": {
    fields: [
      { key: "coupon", label: "Annual coupon payment (₹)", value: 70 },
      { key: "price", label: "Current bond price (₹)", value: 1000 },
    ],
    result: "Current yield",
  },
  "income-tax-calculator": {
    fields: [
      { key: "income", label: "Taxable income (₹)", value: 1000000 },
      { key: "effectiveRate", label: "Estimated effective tax rate (%)", value: 15, step: "0.1" },
    ],
    result: "Illustrative tax estimate",
  },
  "life-cover-calculator": {
    fields: [
      { key: "income", label: "Annual household income (₹)", value: 1200000 },
      { key: "years", label: "Years of income to replace", value: 10 },
      { key: "liabilities", label: "Outstanding liabilities (₹)", value: 2000000 },
      { key: "assets", label: "Existing protection and assets (₹)", value: 1000000 },
    ],
    result: "Indicative life cover need",
  },
  "retirement-calculator": {
    fields: [
      { key: "expenses", label: "Current monthly expenses (₹)", value: 50000 },
      { key: "years", label: "Years until retirement", value: 20 },
      { key: "inflation", label: "Expected inflation (%)", value: 6, step: "0.1" },
      { key: "retirementYears", label: "Years in retirement", value: 25 },
    ],
    result: "Indicative retirement corpus",
  },
  "currency-converter": {
    fields: [
      { key: "amount", label: "Amount", value: 1000 },
      { key: "exchangeRate", label: "Exchange rate", value: 83, step: "0.0001" },
    ],
    result: "Converted amount",
  },
};

const config = configs[slug];
---
{config && (
  <section class="calculator rounded-[14px] border border-line bg-white p-6" data-calculator={slug}>
    <div class="mb-5 flex items-center gap-3">
      <span class="material-symbols-outlined rounded-lg bg-brand/10 p-2 text-brand">calculate</span>
      <div>
        <h2 class="text-xl font-bold text-ink">Try the calculator</h2>
        <p class="text-sm text-muted">Change the assumptions to see an illustrative result.</p>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {config.fields.map((field) => (
        <label class="grid gap-1.5 text-sm font-semibold text-ink">
          {field.label}
          <input
            type="number"
            name={field.key}
            value={field.value}
            step={field.step ?? "1"}
            class="rounded-[10px] border border-line bg-surface px-3 py-2.5 font-normal outline-none focus:border-brand focus:ring-4 focus:ring-brand/10"
          />
        </label>
      ))}
    </div>
    <div class="mt-5 rounded-[12px] bg-ink p-5 text-white">
      <p class="text-xs font-bold uppercase tracking-wide text-white/65">{config.result}</p>
      <output class="calculator-output mt-1 block text-2xl font-extrabold">—</output>
    </div>
    <p class="mt-3 text-xs text-muted">Illustrative educational estimate only. Actual rates, taxes, returns, and product terms may differ.</p>
  </section>
)}

<script>
  const money = new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 });
  document.querySelectorAll<HTMLElement>("[data-calculator]").forEach((calculator) => {
    const value = (name: string) => Number(calculator.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value ?? 0);
    const output = calculator.querySelector<HTMLOutputElement>(".calculator-output");
    const calculate = () => {
      const slug = calculator.dataset.calculator;
      let result = 0;
      let formatted = "—";
      if (slug === "net-worth-calculator") result = value("assets") - value("liabilities");
      if (slug === "fd-maturity-calculator" || slug === "investment-growth-calculator") {
        result = value("principal") * (1 + value("rate") / 100) ** value("years");
      }
      if (slug === "emi-calculator") {
        const months = value("years") * 12;
        const monthlyRate = value("rate") / 1200;
        result = monthlyRate === 0
          ? value("principal") / months
          : value("principal") * monthlyRate * (1 + monthlyRate) ** months / ((1 + monthlyRate) ** months - 1);
      }
      if (slug === "bond-yield-calculator") {
        result = value("price") ? (value("coupon") / value("price")) * 100 : 0;
        formatted = `${result.toFixed(2)}%`;
      }
      if (slug === "income-tax-calculator") result = value("income") * value("effectiveRate") / 100;
      if (slug === "life-cover-calculator") {
        result = Math.max(0, value("income") * value("years") + value("liabilities") - value("assets"));
      }
      if (slug === "retirement-calculator") {
        const annualExpensesAtRetirement = value("expenses") * 12 * (1 + value("inflation") / 100) ** value("years");
        result = annualExpensesAtRetirement * value("retirementYears");
      }
      if (slug === "currency-converter") {
        result = value("amount") * value("exchangeRate");
        formatted = new Intl.NumberFormat("en-IN", { maximumFractionDigits: 2 }).format(result);
      }
      if (output) output.textContent = formatted === "—" ? money.format(result) : formatted;
    };
    calculator.querySelectorAll("input").forEach((input) => input.addEventListener("input", calculate));
    calculate();
  });
</script>
