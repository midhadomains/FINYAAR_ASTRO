---
import "../styles.css";
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import SeoFaq from "../components/SeoFaq.astro";
import ContextLinks from "../components/ContextLinks.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildGenericFaqs, getKeywordTargetByUrl } from "../lib/seo";

const seo = getKeywordTargetByUrl("/contact/")!;
const benefit = "Contact FinYaar Finance about courses, team training, enterprise pricing and practical AI workflows for finance professionals.";
const faqs = buildGenericFaqs(seo.primaryKeyword, benefit);
const pageH1 = seo.primaryKeyword.charAt(0).toUpperCase() + seo.primaryKeyword.slice(1);
const breadcrumbs = [{ label: "Home", href: "/" }, { label: pageH1, href: seo.url }];

const eyebrow = "mb-4 text-xs font-bold uppercase tracking-[0.2em] text-brand";
const inputClass = "w-full rounded-2xl border border-line bg-surface p-4 text-ink placeholder:text-[#8a97b8]";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead target={seo} benefit={benefit} faqs={faqs} />
    <SiteFonts />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="pt-16 pb-12">
        <div class="mx-auto w-[calc(100%-2rem)] max-w-[1160px]">
          <Breadcrumbs items={breadcrumbs} />
          <p class={eyebrow}>Contact</p>
          <h1 class="text-[clamp(2.5rem,5vw,4.5rem)] font-extrabold tracking-[-0.03em] text-ink">{pageH1}</h1>
          <p class="mt-4 max-w-[36rem] text-muted">{pageH1} for questions about courses, team training, enterprise plans or introducing responsible AI workflows into finance operations.</p>
        </div>
      </section>

      <section class="py-16">
        <div class="mx-auto grid w-[calc(100%-2rem)] max-w-[1160px] grid-cols-1 gap-8 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="grid gap-4">
            <h2 class="text-2xl font-extrabold text-ink">We're here to help</h2>
            <p class="text-muted">Reach out for program details, enterprise pricing, or custom finance learning plans.</p>
            <p class="text-muted">Email: <a class="text-brand hover:text-brand-dark" href="mailto:hello@finyaar.com">hello@finyaar.com</a></p>
            <p class="text-muted">Phone: +1 (555) 123-4567</p>
          </div>

          <form class="grid gap-5">
            <label class="grid gap-2 font-semibold text-ink">
              Name
              <input class={inputClass} type="text" name="name" placeholder="Your name" />
            </label>
            <label class="grid gap-2 font-semibold text-ink">
              Email
              <input class={inputClass} type="email" name="email" placeholder="you@example.com" />
            </label>
            <label class="grid gap-2 font-semibold text-ink">
              Message
              <textarea class={inputClass} name="message" rows="6" placeholder="Tell us what you need"></textarea>
            </label>
            <button class="w-fit inline-flex items-center justify-center rounded-full bg-brand px-[1.6rem] py-4 font-bold text-white transition-transform hover:-translate-y-px hover:bg-brand-dark" type="submit">Send Message</button>
          </form>
        </div>
      </section>
      <section class="mx-auto grid w-[calc(100%-2rem)] max-w-[1160px] gap-10 pb-16"><ContextLinks /><SeoFaq faqs={faqs} /></section>
    </main>
    <SiteFooter />
  </body>
</html>
