---
import "../styles.css";
import SiteFonts from "./SiteFonts.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import FinanceCalculator from "./FinanceCalculator.astro";
import SeoFaq from "./SeoFaq.astro";
import SocialMeta from "./SocialMeta.astro";
import { getTermBySlug } from "../lib/dictionary";
import type { ClusterPage, Pillar } from "../lib/pillars";
import { buildGenericFaqs, buildMetaDescription, buildSeoTitle, faqSchema, getClusterSeo } from "../lib/seo";

interface Props {
  pillar: Pillar;
  cluster: ClusterPage;
}

const { pillar, cluster } = Astro.props;
const seo = getClusterSeo(pillar, cluster);
const seoTitle = buildSeoTitle(seo.primaryKeyword);
const metaDescription = buildMetaDescription(seo.primaryKeyword, cluster.summary);
const pageH1 = seo.primaryKeyword.charAt(0).toUpperCase() + seo.primaryKeyword.slice(1);
const openingAnswer = `${pageH1} explains ${cluster.summary.charAt(0).toLowerCase()}${cluster.summary.slice(1)}`;
const faqs = buildGenericFaqs(seo.primaryKeyword, cluster.summary);
const canonicalUrl = new URL(seo.url, Astro.site ?? Astro.url.origin);
const howToSteps = ["Define the outcome you need.", "Gather the relevant figures and constraints.", "Work through the process and review the result."];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", "@id": `${canonicalUrl.href}#article`, headline: pageH1, description: metaDescription, url: canonicalUrl.href, mainEntityOfPage: canonicalUrl.href },
    ...(cluster.kind === "how-to" ? [{
      "@type": "HowTo",
      "@id": `${canonicalUrl.href}#howto`,
      name: pageH1,
      description: cluster.summary,
      url: canonicalUrl.href,
      step: howToSteps.map((text, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: `Step ${index + 1}`,
        text,
        url: `${canonicalUrl.href}#step-${index + 1}`,
      })),
    }] : []),
    faqSchema(faqs, canonicalUrl),
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", canonicalUrl).href },
      { "@type": "ListItem", position: 2, name: pillar.title, item: new URL(`/${pillar.slug}/`, canonicalUrl).href },
      { "@type": "ListItem", position: 3, name: pageH1, item: canonicalUrl.href },
    ] },
  ],
}).replaceAll("<", "\\u003c");
const dictionaryTerm = cluster.dictionarySlug ? getTermBySlug(cluster.dictionarySlug) : undefined;
const clusterIndex = pillar.clusters.findIndex((item) => item.slug === cluster.slug);
const related = Array.from(
  { length: Math.min(4, Math.max(0, pillar.clusters.length - 1)) },
  (_, offset) => pillar.clusters[(clusterIndex + offset + 1) % pillar.clusters.length],
);
const kindLabel = {
  explainer: "Explainer",
  "how-to": "How-to guide",
  comparison: "Comparison",
  calculator: "Calculator",
  "exam-guide": "Exam guide",
}[cluster.kind];

const guidance = {
  explainer: ["Start with the definition and purpose.", "Understand the mechanics and common inputs.", "Check limitations before applying the concept."],
  "how-to": howToSteps,
  comparison: ["Compare like-for-like features and costs.", "Separate short-term convenience from long-term impact.", "Choose according to your goal and risk tolerance."],
  calculator: ["Use realistic assumptions rather than best-case estimates.", "Test more than one scenario.", "Treat the result as a planning estimate, not a guarantee."],
  "exam-guide": ["Map the topic to the official curriculum.", "Learn the concept before memorising formulas.", "Use timed practice to identify weak areas."],
}[cluster.kind];
---
<!DOCTYPE html>
<html lang="en" data-page-kind={cluster.kind}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={seo.primaryKeyword} />
    <link rel="canonical" href={canonicalUrl} />
    <SocialMeta title={seoTitle} description={metaDescription} canonicalUrl={canonicalUrl} type="article" />
    <meta property="article:tag" content={seo.primaryKeyword} />
    <script is:inline type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem("finyaar-theme") === "dark" ? "dark" : "light"; } catch {}
    </script>
    <SiteFonts />
  </head>
  <body class="article-theme">
    <SiteHeader articleTheme />
    <main class="mx-auto w-[calc(100%-2rem)] max-w-[1160px] py-10">
      <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-muted">
        <a href="/" class="hover:text-brand">Home</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <a href={`/${pillar.slug}/`} data-pillar-link class="hover:text-brand">{pillar.title}</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-ink">{cluster.title}</span>
      </nav>

      <div class="grid gap-9 lg:grid-cols-[1fr_320px]">
        <article class="space-y-8">
          <header class="rounded-[18px] border border-line bg-white p-7 sm:p-9">
            <span class="inline-flex items-center gap-2 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-brand">
              <span class="material-symbols-outlined text-[17px]">{pillar.icon}</span>
              {kindLabel}
            </span>
            <h1 class="mt-5 text-[clamp(2.2rem,5vw,3.5rem)] font-extrabold tracking-[-0.035em] text-ink">{pageH1}</h1>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{openingAnswer}</p>
          </header>

          {dictionaryTerm && (
            <section class="rounded-r-[14px] border-l-4 border-brand bg-brand/5 p-6">
              <p class="text-xs font-bold uppercase tracking-wide text-brand">Dictionary foundation</p>
              <h2 class="mt-2 text-xl font-bold text-ink">
                {cluster.kind === "calculator" ? "Concept behind this calculation" : dictionaryTerm.term}
              </h2>
              <p class="mt-2 leading-relaxed text-muted">{dictionaryTerm.definition}</p>
              <a href={`/dictionary/${dictionaryTerm.slug}/`} class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-brand hover:underline">
                Read the complete dictionary lesson
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </section>
          )}

          {cluster.kind === "calculator" && <FinanceCalculator slug={cluster.slug} />}

          <section class="rounded-[14px] border border-line bg-white p-6 sm:p-8">
            <h2 class="text-2xl font-extrabold text-ink">How to approach {cluster.title}</h2>
            <p class="mt-3 leading-relaxed text-muted">
              This page belongs to the <a href={`/${pillar.slug}/`} class="font-semibold text-brand hover:underline">{pillar.title}</a> learning pillar. Use it after the core definition and before moving into product selection, modelling, or exam practice.
            </p>
            <ol class="mt-6 grid gap-4">
              {guidance.map((item, index) => (
                <li id={`step-${index + 1}`} class="flex scroll-mt-24 gap-4 rounded-[12px] bg-surface p-4">
                  <span class="grid h-8 w-8 flex-shrink-0 place-items-center rounded-full bg-brand text-sm font-bold text-white">{index + 1}</span>
                  <p class="pt-1 font-semibold text-ink">{item}</p>
                </li>
              ))}
            </ol>
          </section>

          <section>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand">Continue learning</p>
            <h2 class="mt-2 text-2xl font-extrabold text-ink">Related {pillar.title} pages</h2>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {related.map((item) => (
                <a href={`/${pillar.slug}/${item.slug}/`} class="group rounded-[14px] border border-line bg-white p-5 hover:border-brand">
                  <span class="text-xs font-bold uppercase tracking-wide text-muted">{item.kind.replace("-", " ")}</span>
                  <h3 class="mt-2 font-bold text-ink group-hover:text-brand">{item.title}</h3>
                  <p class="mt-2 line-clamp-2 text-sm text-muted">{item.summary}</p>
                </a>
              ))}
            </div>
          </section>

          <SeoFaq faqs={faqs} />

          <p class="border-t border-line pt-6 text-xs leading-relaxed text-muted">
            Educational content only. Calculations and examples are illustrative and are not investment, legal, tax, credit, or insurance advice.
          </p>
        </article>

        <aside class="space-y-5 lg:sticky lg:top-28 lg:h-fit">
          <a href={`/${pillar.slug}/`} data-pillar-link class="block rounded-[14px] bg-ink p-6 text-white transition-transform hover:-translate-y-0.5">
            <span class="material-symbols-outlined text-accent-soft">hub</span>
            <p class="mt-3 text-xs font-bold uppercase tracking-wide text-white/60">Pillar hub</p>
            <h2 class="mt-1 text-xl font-bold">{pillar.title}</h2>
            <p class="mt-2 text-sm text-white/75">See every guide, comparison, calculator, and dictionary term in this topic.</p>
          </a>
          <a href="/dictionary/" class="flex items-center justify-between rounded-[14px] border border-line bg-white p-5 font-bold text-ink hover:border-brand hover:text-brand">
            Finance Dictionary
            <span class="material-symbols-outlined">menu_book</span>
          </a>
          <a href="/topics/" class="flex items-center justify-between rounded-[14px] border border-line bg-white p-5 font-bold text-ink hover:border-brand hover:text-brand">
            All finance pillars
            <span class="material-symbols-outlined">apps</span>
          </a>
        </aside>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
