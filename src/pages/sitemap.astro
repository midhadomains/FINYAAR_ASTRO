---
import "../styles.css";
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import { dictionaryCategories, terms } from "../lib/dictionary";
import { pillars } from "../lib/pillars";
import { buildGenericFaqs, getKeywordTargetByUrl } from "../lib/seo";

const seo = getKeywordTargetByUrl("/sitemap/")!;
const benefit = "Browse every public FinYaar page, topic hub, finance dictionary category, and lesson.";
const faqs = buildGenericFaqs(seo.primaryKeyword, benefit);
const staticPages = [
  { label: "Home", href: "/" },
  { label: "Topics", href: "/topics/" },
  { label: "Finance Dictionary", href: "/dictionary/" },
  { label: "Courses", href: "/courses/" },
  { label: "AI Finance Vault", href: "/vault/" },
  { label: "Blog", href: "/blog/" },
  { label: "About FinYaar", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead target={seo} benefit={benefit} faqs={faqs} />
    <SiteFonts />
  </head>
  <body class="hub-dark">
    <SiteHeader />
    <main class="mx-auto w-[calc(100%-2rem)] max-w-[1160px] py-12">
      <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-sm text-muted">
        <a href="/" class="hover:text-brand">Home</a>
        <span aria-hidden="true" class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-ink">Sitemap</span>
      </nav>

      <header class="mb-12 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand">Explore FinYaar</p>
        <h1 class="mt-3 text-[clamp(2.4rem,5vw,4rem)] font-extrabold tracking-[-0.035em] text-ink">Sitemap</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">Find every public page across FinYaar's finance topics, dictionary, learning paths, and practical guides.</p>
      </header>

      <div class="grid gap-12 lg:grid-cols-2">
        <section aria-labelledby="site-pages">
          <h2 id="site-pages" class="mb-5 text-2xl font-bold text-ink">Site pages</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {staticPages.map((page) => (
              <li><a href={page.href} class="block rounded-xl border border-line bg-white px-4 py-3 font-semibold text-ink transition-colors hover:border-brand hover:text-brand">{page.label}</a></li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="dictionary-pages">
          <h2 id="dictionary-pages" class="mb-5 text-2xl font-bold text-ink">Dictionary categories</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {dictionaryCategories.map((category) => (
              <li><a href={`/dictionary/category/${category.slug}/`} class="block rounded-xl border border-line bg-white px-4 py-3 font-semibold text-ink transition-colors hover:border-brand hover:text-brand">{category.label}<span class="mt-1 block text-xs font-normal text-muted">{category.termCount} {category.termCount === 1 ? "lesson" : "lessons"}</span></a></li>
            ))}
          </ul>
        </section>
      </div>

      <section aria-labelledby="topic-pages" class="mt-14">
        <h2 id="topic-pages" class="mb-5 text-2xl font-bold text-ink">Topic hubs and guides</h2>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {pillars.map((pillar) => (
            <article class="rounded-xl border border-line bg-white p-5">
              <h3 class="text-lg font-bold text-ink"><a href={`/${pillar.slug}/`} class="hover:text-brand">{pillar.title}</a></h3>
              <ul class="mt-4 grid gap-2 border-t border-line pt-4 text-sm">
                {pillar.clusters.map((cluster) => (
                  <li><a href={`/${pillar.slug}/${cluster.slug}/`} class="text-muted hover:text-brand">{cluster.title}</a></li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="lesson-pages" class="mt-14">
        <h2 id="lesson-pages" class="mb-5 text-2xl font-bold text-ink">Dictionary lessons <span class="text-base font-normal text-muted">({terms.length})</span></h2>
        <div class="columns-1 gap-x-8 sm:columns-2 lg:columns-3">
          {terms.sort((a, b) => a.term.localeCompare(b.term)).map((term) => (
            <a href={`/dictionary/${term.slug}/`} class="mb-2 block break-inside-avoid text-sm text-muted hover:text-brand">{term.term}</a>
          ))}
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>